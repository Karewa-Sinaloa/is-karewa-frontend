VITE_API_ENDPOINT=https://example-api.local/api/v5
# Override opcional del origen del contrato OpenAPI en `pnpm api:sync`;
# por defecto el origen se deriva de VITE_API_ENDPOINT. Descomentar solo para explorar otro despliegue.
# OPENAPI_URL=https://example-api.local/api/docs/openapi.json
VITE_LOCALSTORAGE_SUFFIX=karewa_
VITE_PASS_RESET_URL=https://app.example.local/acceso/cambiar-contrasena
VITE_USER_VERIFICATION_URL=https://app.example.local/acceso/verificacion-de-usuario
VITE_HCAPTCHA_KEY=REPLACE_ME
VITE_CURRENCY_CODE=mxn
VITE_CURRENCY_LOCALE=es-MX
VITE_CURRENCY_DECIMALS=3
VITE_DEBUG=true

CLOUDFLARED_TUNNEL_NAME=karewa_app
CLOUDFLARED_TUNNEL_ID=REPLACE_WITH_NEW_TUNNEL_UUID
CLOUDFLARED_HOSTNAME=kapp.chavodigital.com
CLOUDFLARED_TUNNEL_STRATEGY=create_new
CLOUDFLARED_TUNNEL_MODE=named
CLOUDFLARED_TUNNEL_TARGET=proxy
CLOUDFLARED_CREDENTIALS_FILE=/etc/cloudflared/REPLACE_WITH_NEW_TUNNEL_UUID.json
CLOUDFLARED_HOST_CREDENTIALS_PATH=/home/criselgeek/.cloudflared/REPLACE_WITH_NEW_TUNNEL_UUID.json
